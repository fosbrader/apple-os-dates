{
  "name": "beta-cadence",
  "version": "1.0.0",
  "description": "Apple operating-system beta and public release date tracker",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "data:parse-note": "tsx scripts/parse-apple-notes.ts",
    "data:build": "tsx scripts/build-release-data.ts --write",
    "data:build:check": "tsx scripts/build-release-data.ts",
    "data:validate": "tsx scripts/validate-release-data.ts",
    "forecast:validate": "tsx scripts/validate-forecasts.ts",
    "sanity:backfill:2026:check": "sanity exec scripts/backfill-2026-releases.ts --with-user-token",
    "sanity:backfill:2026:apply": "sanity exec scripts/backfill-2026-releases.ts --with-user-token -- --apply",
    "sanity:history:check": "sanity exec scripts/reconcile-release-history.ts --with-user-token",
    "sanity:history:apply": "sanity exec scripts/reconcile-release-history.ts --with-user-token -- --apply",
    "sanity:seed": "sanity exec scripts/seed-sanity.ts --with-user-token"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fosbrader/apple-os-dates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fosbrader/apple-os-dates/issues"
  },
  "homepage": "https://www.betacadence.com/",
  "dependencies": {
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.10.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "framer-motion": "^12.34.1",
    "next": "^16.1.6",
    "next-sanity": "^12.1.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.10.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@sanity/client": "^7.15.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0"
  }
}

{
  "name": "version-record",
  "version": "1.0.0",
  "description": "Source-backed software release history and notes archive",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "api:client:generate": "tsx scripts/generate-public-api-client.ts",
    "api:client:check": "tsx scripts/generate-public-api-client.ts --check",
    "api:contract": "npm run api:client:check && npx tsc --noEmit && npm test",
    "submissions:operator:provision": "/usr/bin/expect scripts/provision-submission-operator.exp",
    "submissions:moderate": "/usr/bin/env -u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS -u PS4 /bin/bash --noprofile --norc -p scripts/run-submission-operator.sh",
    "data:parse-note": "tsx scripts/parse-apple-notes.ts",
    "data:build": "tsx scripts/build-release-data.ts --write",
    "data:build:check": "tsx scripts/build-release-data.ts",
    "data:validate": "tsx scripts/validate-release-data.ts",
    "forecast:validate": "tsx scripts/validate-forecasts.ts",
    "historical:validate": "tsx scripts/validate-historical-analysis-dataset.ts",
    "walk-forward:validate": "tsx scripts/validate-walk-forward-evaluation.ts",
    "release-date:validate": "tsx scripts/validate-release-date-candidates.ts",
    "evidence:inventory": "tsx scripts/generate-evidence-inventory.ts --write",
    "evidence:inventory:check": "tsx scripts/generate-evidence-inventory.ts --check",
    "migration:events:plan": "tsx scripts/plan-release-event-migration.ts",
    "migration:chronology-metadata:plan": "tsx scripts/plan-chronology-metadata-migration.ts",
    "research:validate": "node --import tsx scripts/validate-research-batches.ts",
    "sanity:coverage:report": "sanity exec scripts/report-content-coverage.ts --with-user-token --",
    "sanity:launch:check": "sanity exec scripts/ingest-launch-content.ts --with-user-token -- --content scripts/apple-launch-content-2026.json",
    "sanity:history:check": "sanity exec scripts/reconcile-release-history.ts --with-user-token",
    "sanity:history:apply": "sanity exec scripts/reconcile-release-history.ts --with-user-token -- --apply"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fosbrader/apple-os-dates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fosbrader/apple-os-dates/issues"
  },
  "homepage": "https://www.versionrecord.com/",
  "engines": {
    "node": "^22.13.0"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.29.0"
    },
    "@module-federation/vite": {
      "@module-federation/dts-plugin": "2.8.2"
    },
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    },
    "@sanity/workbench-cli": {
      "@module-federation/vite": "1.20.5"
    },
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "4.3.1",
      "smol-toml": "1.7.1"
    },
    "next": {
      "postcss": "$postcss",
      "sharp": "0.35.0"
    },
    "postcss": {
      "nanoid": "3.3.18"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^6.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/firewall": "^1.2.2",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.1",
    "next": "^16.1.6",
    "next-sanity": "^13.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=lh3yswzu
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical production URL
CANONICAL_SITE_URL=https://www.betacadence.com

# Optional search-engine ownership verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional Google Analytics 4 web-stream measurement ID (starts with G-)
# The Google tag remains unloaded until a visitor accepts analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public privacy contact and controller/operator identity.
# Both are required before GA4 or AdSense verification can be enabled.
# SITE_CONTACT_EMAIL=
# SITE_OPERATOR_NAME=

# Configure once AdSense issues the publisher ID, while adding the site for review.
# Accepts pub-0000000000000000 or ca-pub-0000000000000000.
# This publishes the verification meta tag and /ads.txt; it does not load ads.
# GOOGLE_ADSENSE_PUBLISHER_ID=

# Token only needed for controlled imports or other server-side mutations
SANITY_API_TOKEN=your_token_here

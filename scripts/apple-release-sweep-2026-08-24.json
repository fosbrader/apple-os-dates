        {"url": "https://9to5mac.com/2026/08/17/apple-rolls-out-release-candidates-for-macos-tahoe-26-7-and-macos-sequoia-15-8/", "locator": "macOS Tahoe 26.7 RC, build 25G220"},
        {"url": "https://9to5mac.com/2026/08/24/second-release-candidates-for-macos-tahoe-26-7-and-macos-sequoia-15-8-now-available/", "locator": "macOS Tahoe 26.7 RC 2, build 25G224"}
      ],

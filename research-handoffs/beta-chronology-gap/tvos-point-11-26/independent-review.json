    "finding": "Thirty-seven unchanged identities have two genuinely independent frozen publisher lineages proving tvOS, the exact version, the public channel, a displayed public-program ordinal, and a resolved America/Los_Angeles date. Seventy-nine identities remain blocked: thirty-six packet-supportable rows fail the strict gate and all forty-three preblocked rows remain unresolved. Twelve parents have no approved appearance but remain public-beta-applicable and reversible. None of the fifteen packet negative findings proves historical non-applicability."
  },
  "evidenceGate": {
    "requiredIdentityFields": [
      "platform tvOS",
      "exact full version",
      "public-beta audience",
      "publisher-displayed public-program ordinal",
      "America/Los_Angeles appearance date"
    ],
    "minimumIndependentPublisherFamilies": 2,
    "acceptedPublicOrdinalRule": "A source must display Public Beta N, an ordinal public beta, or a standalone public-channel statement that the numbered beta of the exact tvOS version was seeded to the publisher's identified public beta testing group.",
    "rejectedPublicOrdinalRule": "A developer or generic beta numeral followed only by a generic public-availability update does not establish the public-program ordinal.",
    "prohibitedInferences": [
      "developer ordinal or cadence",
      "generic beta numeral plus generic public availability",
      "build alignment",
      "paired-platform release",
      "release-candidate or golden-master equivalence",
      "search-result snippet without corroborating full evidence",
      "living-page text that does not preserve the historical tvOS identity",
      "derivative attribution counted as an independent lineage",
      "search silence or stable-note silence"
    ]
  },
  "reasonCodeDefinitions": {
    "APPROVED_EXACT_TWO_INDEPENDENT_LINEAGES": "Two independent publisher families establish every submitted identity field on one resolved Pacific date.",
    "BLOCK_SECOND_INDEPENDENT_EXACT_LINEAGE_MISSING": "One exact lineage remains after nonqualifying evidence is excluded.",
    "BLOCK_EXACT_PUBLIC_ORDINAL_MISSING": "The retained sources do not display a tvOS public-program ordinal for the apparent identity.",

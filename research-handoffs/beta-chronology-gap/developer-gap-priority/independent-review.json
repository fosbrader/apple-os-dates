  "conflictAdjudications": [
    {
      "conflictId": "conflict-ios921-cross-channel-aggregate-three",
      "disposition": "resolvedNonBlocking",
      "finding": "MacRumors says developers and public testers received a total of three betas; that is a cross-channel aggregate, not an explicit developer Beta 3. Two-source direct evidence supports developer Betas 1 and 2, and AppleInsider explicitly states there were two developer betas.",
      "requiredHandling": "Keep developer Betas 1 and 2 only. Never derive developer Beta 3 from the aggregate sentence."
    },
    {
      "conflictId": "conflict-ios1032-final-four-versus-beta-five",
      "disposition": "resolvedNonBlocking",
      "finding": "MacRumors' later four-beta aggregate conflicts with its own direct Beta 5 article, Macerkopf's Beta 5 article, iDownloadBlog's Beta 5 article, and Forbes' five-beta final count. The direct identity evidence controls.",
      "requiredHandling": "Keep Beta 5 and classify the four-beta aggregate as a reporting error. Do not use either aggregate count to infer a Beta 6."
    }
